{
  "name": "attendance-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Attendance App Monorepo (Frontend and Backend)",
  "scripts": {
    "start:frontend": "npm start --prefix frontend",
    "start:backend": "npm start --prefix backend",
